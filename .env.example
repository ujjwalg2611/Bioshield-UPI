# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Core Flask ---
# Required in production (app raises at startup if unset when RENDER or
# FLASK_ENV=production is detected). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# postgresql://user:password@host:5432/dbname  (defaults to local sqlite if unset)
DATABASE_URL=

# Set to "production" outside local dev so SECRET_KEY is enforced
FLASK_ENV=development

# --- Face image encryption (biometric data at rest) ---
# Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a random key is generated per-process - previously enrolled faces
# become unreadable after every restart. Set this for real persistence.
FACE_ENCRYPTION_KEY=

# --- OTP delivery via SMTP (optional - falls back to console log if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Sepolia testnet notarization (optional - skipped entirely if unset) ---
# Get a free RPC URL from Infura or Alchemy, e.g.:
#   https://sepolia.infura.io/v3/<project-id>
RPC_URL=
# Private key of a funded Sepolia testnet account (never use a mainnet key)
PRIVATE_KEY=
# Address printed by scripts/deploy_contract.py after deployment
CONTRACT_ADDRESS=

# --- Demo/debug only - do NOT set true in production ---
# When true, OTP codes are echoed back in the API response for local testing
DEMO_MODE=false

# --- Risk engine ---
# zscore (default, original heuristic) | mahalanobis (ml/risk_model.py).
# Both scores are always logged per payment; switch only after checking them.
RISK_ENGINE=zscore
# true = score >= 0.65 cancels the payment instead of offering face/OTP step-up
BLOCK_ENFORCED=false

# --- OTP delivery via SMS (optional; preferred over SMTP when all three are set) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Security behaviour ---
# stepup (default, fail closed) | allow: what to do when a user has < 3 enrollment samples
COLD_START_POLICY=stepup
# Comma-separated origins allowed cross-origin access. Empty = same-origin only
# (the UI is served by this app, so you normally don't need any).
CORS_ORIGINS=
